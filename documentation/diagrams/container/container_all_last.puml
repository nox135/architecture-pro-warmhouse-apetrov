@startuml C4_Containers_All
!include ../C4_Container.puml


' === Участники системы ===
Person(user, "Пользователь", "Управляет устройствами и просматривает данные через веб или мобильное приложение")

System_Ext(devices, "Умные устройства", "Физические датчики, реле, камеры, ворота")
System_Ext(partners, "Партнёрские API", "Интеграция с устройствами партнёров (MQTT, Zigbee, HTTP)")

' === Система "Тёплый дом" ===
System_Boundary(home_system, "Экосистема 'Тёплый дом'") {

    ' --- API Gateway ---
    Container(api_gateway, "API Gateway", "Nginx / Flask", "Единая точка входа для всех клиентов. Маршрутизация запросов к микросервисам")

    ' --- Домен пользователей ---
    Container(user_service, "User Service", "Flask", "Регистрация, аутентификация, профили пользователей")
    ContainerDb(user_db, "Users DB", "PostgreSQL", "Таблицы users, homes, roles, sessions")

    ' --- Домен устройств ---
    Container(device_service, "Device Service", "Flask", "Регистрация и конфигурация устройств")
    Container(control_service, "Control Service", "Flask", "Обработка команд для управления устройствами")
    ContainerDb(device_db, "Devices DB", "PostgreSQL", "Таблицы devices, device_types, device_state, integration_tokens")

    ' --- Домен телеметрии ---
    Container(telemetry_service, "Telemetry Service", "FastAPI", "Сбор и хранение данных телеметрии от устройств")
    Container(analytics_service, "Analytics Service", "FastAPI", "Аналитика и отчёты по данным телеметрии")
    ContainerDb(telemetry_db, "Telemetry DB", "TimescaleDB", "Таблицы telemetry, metrics, alerts")

    ' --- Инфраструктура ---
    Container(message_broker, "Message Broker", "RabbitMQ / Kafka", "Асинхронный обмен событиями между сервисами")
}

' === Связи ===
Rel(user, api_gateway, "Отправляет запросы", "HTTPS/REST")
Rel(api_gateway, user_service, "Запросы авторизации, профиля")
Rel(api_gateway, device_service, "Регистрация устройств")
Rel(api_gateway, control_service, "Команды управления")
Rel(api_gateway, telemetry_service, "Получение данных телеметрии")
Rel(api_gateway, analytics_service, "Запрос аналитики и отчётов")

Rel(user_service, user_db, "Читает и пишет данные пользователей", "SQL")
Rel(device_service, device_db, "Читает и пишет данные об устройствах", "SQL")
Rel(control_service, device_db, "Читает состояние устройств", "SQL")
Rel(telemetry_service, telemetry_db, "Хранит телеметрию", "SQL")
Rel(analytics_service, telemetry_db, "Читает агрегированные данные", "SQL")

Rel(device_service, partners, "Интеграция по API", "MQTT / Zigbee / HTTP")
Rel(control_service, devices, "Отправляет команды", "MQTT / HTTP")
Rel(devices, telemetry_service, "Передают показания", "MQTT / HTTP")

Rel(telemetry_service, message_broker, "Публикует новые данные", "Events")
Rel(analytics_service, message_broker, "Подписывается на данные телеметрии", "Events")

@enduml
