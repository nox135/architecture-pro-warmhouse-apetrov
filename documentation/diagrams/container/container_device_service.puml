@startuml C4_Containers_DeviceService
!include ../C4_Container.puml

System_Boundary(ds, "Device Service") {
    Container(api, "Device API", "Flask / Python", "Управление устройствами через REST API")
    Container(registry, "Device Registry", "Python", "Регистрация и хранение информации об устройствах")
    Container(control, "Device Control", "Python", "Управление состоянием устройств (вкл/выкл, настройки)")
    Container(adapter, "Integration Adapter", "Python", "Интеграция с API партнёров")
    ContainerDb(db, "Devices DB", "PostgreSQL", "Информация об устройствах, типах и состоянии")
}

System_Ext(ext_device, "Физические устройства", "Датчики, камеры, реле")
System_Ext(ext_partner, "Партнёрские API", "Внешние интеграции")

Rel(api, registry, "Создание и управление устройствами")
Rel(api, control, "Команды управления устройствами")
Rel(control, ext_device, "Передаёт команды")
Rel(adapter, ext_partner, "Интеграция с партнёрскими API")
Rel(registry, db, "Чтение/запись данных устройств")
Rel(control, db, "Сохраняет состояние устройств")

@enduml